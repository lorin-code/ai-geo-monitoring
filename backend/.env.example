# Server
PORT=3002
NODE_ENV=development

# Database
# Relative paths are resolved from the backend process working directory.
DB_STORAGE=database.sqlite
# Production Supabase/Postgres example:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Security
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Default admin bootstrap
# Change this before first production startup.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Membership defaults
DEFAULT_MEMBERSHIP_LEVEL=free

# User AI keys are entered and validated in the profile page, not in this file.
# Optional: stable 32-byte hex key for encrypting user credentials.
# If omitted, backend/.platform-credential-key is created on the first save.
# PLATFORM_CREDENTIAL_ENCRYPTION_KEY=
